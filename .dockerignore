# Report dirs at repo root only — do not exclude scripts/coverage/ kcov drivers
/coverage/
/coverage_*/
.cache/
reports/
.git/
.github/
.idea/
.vscode/
build/
*.log
assets/*.svg

# Local secrets must never reach a build context (COPY . .). Mirrors .gitignore:
# ssmtp.conf holds real SMTP credentials on a developer machine.
ssmtp.conf
dead.letter
.env
*.pem
*.key
