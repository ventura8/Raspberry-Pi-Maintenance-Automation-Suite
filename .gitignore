# Ignore the actual configuration file containing passwords
ssmtp.conf

# Ignore local log files
*.log
tmp.*

# Ignore system files
.DS_Store
Thumbs.db

# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class

# Local Docker/build cache and CI log output
.cache/
reports/

# Mail transport artifacts (ssmtp/msmtp local failures)
dead.letter

# Coverage reports at repo root only (do not match scripts/coverage/ kcov drivers)
/coverage/
/coverage_*/
kcov-merged/
mocks/
scripts_test/
pi-scripts/
*.txt
code-coverage-results.md
